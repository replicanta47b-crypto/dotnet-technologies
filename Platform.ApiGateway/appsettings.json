{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Metadata": { "Team": "payments", "Version": "v1" }
      },
      "customers": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "payments-invoices": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/invoices/{**catch-all}" }
      },
      "billing": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/billing/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/billing" },
          { "PathPrefix": "/api" }
        ],
        "Metadata": { "Team": "billing", "Version": "v1" }
      },
      "billing-merchants": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/merchants/{**catch-all}" }
      },
      "billing-categories": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "disputes": {
        "ClusterId": "disputes",
        "Match": { "Path": "/api/disputes/{**catch-all}" },
        "Metadata": { "Team": "disputes", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "payments": {
        "Destinations": { "d1": { "Address": "http://payments-api" } },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "billing": {
        "Destinations": { "d1": { "Address": "http://billing-api" } },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "disputes": {
        "Destinations": { "d1": { "Address": "http://disputes-api" } },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      }
    }
  }
}
