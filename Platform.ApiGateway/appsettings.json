{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Metadata": {
          "Team": "platform",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Metadata": {
          "Team": "payments",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "customers": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "payments-invoices": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/invoices/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "billing": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/billing"
          },
          {
            "PathPrefix": "/api"
          }
        ],
        "Metadata": {
          "Team": "billing",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "billing-merchants": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/merchants/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "billing-categories": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "disputes": {
        "ClusterId": "disputes",
        "Match": {
          "Path": "/api/disputes/{**catch-all}"
        },
        "Metadata": {
          "Team": "disputes",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "auth": {
        "ClusterId": "auth",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Metadata": {
          "Team": "auth",
          "Version": "v1"
        }
      },
      "users": {
        "ClusterId": "auth",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "settlements": {
        "ClusterId": "settlements",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/settlements/{**catch-all}"
        },
        "Metadata": {
          "Team": "settlements",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "Destinations": {
          "d1": {
            "Address": "http://aggregator"
          }
        }
      },
      "payments": {
        "Destinations": {
          "d1": {
            "Address": "http://payments-api"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "billing": {
        "Destinations": {
          "d1": {
            "Address": "http://billing-api"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "disputes": {
        "Destinations": {
          "d1": {
            "Address": "http://disputes-api"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://auth-api"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "settlements": {
        "Destinations": {
          "d1": {
            "Address": "http://settlements-api"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      }
    }
  }
}
