<Project Sdk="Microsoft.NET.Sdk">

  <!-- Лаб. 08: шина подій на RabbitMQ — підключення, топологія, publisher, consumer, передача контексту трасування.
       Бізнес-логіки тут немає: обробники подій живуть у сервісах (Services/*/…/IntegrationEvents). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire-інтеграція: AddRabbitMQClient("messaging") реєструє IConnection (singleton), health check й рядок підключення від AppHost -->
    <!-- Aspire.RabbitMQ.Client.v7 — той самий AddRabbitMQClient, але для RabbitMQ.Client 7.x (пакет без суфікса прив'язаний до 6.x) -->
    <PackageReference Include="Aspire.RabbitMQ.Client.v7" Version="9.5.2" />
    <!-- RabbitMQ.Client 7.x: повністю асинхронний API (IChannel, BasicPublishAsync, BasicConsumeAsync, BasicAckAsync) -->
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <!-- Явна версія: без неї NuGet вибирає 8.0.1 (найближча залежність) і дає NU1605 щодо 9.0.9 з AutoActivation -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.9" />
    <!-- Propagators.DefaultTextMapPropagator: W3C traceparent -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.12.0" />
  </ItemGroup>

</Project>
