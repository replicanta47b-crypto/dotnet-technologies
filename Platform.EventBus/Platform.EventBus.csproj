<Project Sdk="Microsoft.NET.Sdk">

  <!-- Лаб. 08: шина подій на RabbitMQ — підключення, топологія, publisher, consumer, передача контексту трасування.
       Бізнес-логіки тут немає: обробники подій живуть у сервісах (Services/*/…/IntegrationEvents). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire-інтеграція: AddRabbitMQClient("messaging") реєструє IConnection (singleton), health check й рядок підключення від AppHost -->
    <PackageReference Include="Aspire.RabbitMQ.Client" Version="9.5.0" />
    <!-- RabbitMQ.Client 7.x: повністю асинхронний API (IChannel, BasicPublishAsync, BasicConsumeAsync, BasicAckAsync) -->
    <PackageReference Include="RabbitMQ.Client" Version="7.*" />
    <!-- Propagators.DefaultTextMapPropagator: W3C traceparent -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.12.0" />
  </ItemGroup>

</Project>
