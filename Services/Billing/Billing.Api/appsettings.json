{
  "ConnectionStrings": {
    "BillingDb": "Server=localhost\\MSSQLSERVER01;Database=BillingEfDb;Integrated Security=true;TrustServerCertificate=true;"
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Database": {
    "MigrateOnStartup": true,
    "Seed": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/billing-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
