{
  "MongoDb": {
    "ConnectionString": "mongodb://127.0.0.1:27017/?maxPoolSize=50&serverSelectionTimeoutMS=5000",
    "DatabaseName": "disputes_db"
  },
  "LuckyPenny": {
    "LicenseKey": ""
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Database": {
    "Seed": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/disputes-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
