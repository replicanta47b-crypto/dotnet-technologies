{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "sql-password": {
      "type": "parameter.v0",
      "value": "{sql-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "sql": {
      "type": "container.v0",
      "connectionString": "Server={sql.bindings.tcp.host},{sql.bindings.tcp.port};User ID=sa;Password={sql-password.value};TrustServerCertificate=true",
      "image": "mcr.microsoft.com/mssql/server:2025-latest",
      "volumes": [
        {
          "name": "platform.apphost-04e9402f01-sql-data",
          "target": "/var/opt/mssql",
          "readOnly": false
        }
      ],
      "env": {
        "ACCEPT_EULA": "Y",
        "MSSQL_SA_PASSWORD": "{sql-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 1433
        }
      }
    },
    "PaymentsDb": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=PaymentsDb"
    },
    "BillingDb": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=BillingDb"
    },
    "IdentityDb": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=IdentityDb"
    },
    "mongo": {
      "type": "container.v0",
      "connectionString": "mongodb://admin:{mongo-password.value}@{mongo.bindings.tcp.host}:{mongo.bindings.tcp.port}?authSource=admin\u0026authMechanism=SCRAM-SHA-256",
      "image": "docker.io/library/mongo:8.0",
      "volumes": [
        {
          "name": "platform.apphost-04e9402f01-mongo-data",
          "target": "/data/db",
          "readOnly": false
        }
      ],
      "env": {
        "MONGO_INITDB_ROOT_USERNAME": "admin",
        "MONGO_INITDB_ROOT_PASSWORD": "{mongo-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 27017
        }
      }
    },
    "DisputesDb": {
      "type": "value.v0",
      "connectionString": "mongodb://admin:{mongo-password.value}@{mongo.bindings.tcp.host}:{mongo.bindings.tcp.port}/DisputesDb?authSource=admin\u0026authMechanism=SCRAM-SHA-256"
    },
    "redis": {
      "type": "container.v0",
      "connectionString": "{redis.bindings.tcp.host}:{redis.bindings.tcp.port},password={redis-password.value}",
      "image": "docker.io/library/redis:8.2",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "redis-server --requirepass $REDIS_PASSWORD --save 60 1"
      ],
      "volumes": [
        {
          "name": "platform.apphost-04e9402f01-redis-data",
          "target": "/data",
          "readOnly": false
        }
      ],
      "env": {
        "REDIS_PASSWORD": "{redis-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 6379
        }
      }
    },
    "messaging-username": {
      "type": "parameter.v0",
      "value": "{messaging-username.inputs.value}",
      "inputs": {
        "value": {
          "type": "string"
        }
      }
    },
    "messaging-password": {
      "type": "parameter.v0",
      "value": "{messaging-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "messaging": {
      "type": "container.v0",
      "connectionString": "amqp://{messaging-username.value}:{messaging-password.value}@{messaging.bindings.tcp.host}:{messaging.bindings.tcp.port}",
      "image": "docker.io/library/rabbitmq:4.1-management",
      "volumes": [
        {
          "name": "platform.apphost-04e9402f01-messaging-data",
          "target": "/var/lib/rabbitmq",
          "readOnly": false
        }
      ],
      "env": {
        "RABBITMQ_DEFAULT_USER": "{messaging-username.value}",
        "RABBITMQ_DEFAULT_PASS": "{messaging-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5672
        },
        "management": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 15672
        }
      }
    },
    "jwt-secret": {
      "type": "parameter.v0",
      "value": "{jwt-secret.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "payments-api": {
      "type": "project.v0",
      "path": "../Services/Payments/Payments.Api/Payments.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{payments-api.bindings.http.targetPort}",
        "ConnectionStrings__PaymentsDb": "{PaymentsDb.connectionString}",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "Database__InitializeOnStartup": "true",
        "Auth__AuthService__SecretKey": "{jwt-secret.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "billing-api": {
      "type": "project.v0",
      "path": "../Services/Billing/Billing.Api/Billing.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{billing-api.bindings.http.targetPort}",
        "ConnectionStrings__BillingDb": "{BillingDb.connectionString}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "Auth__AuthService__SecretKey": "{jwt-secret.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "disputes-api": {
      "type": "project.v0",
      "path": "../Services/Disputes/Disputes.WebApi/Disputes.WebApi.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{disputes-api.bindings.http.targetPort}",
        "ConnectionStrings__DisputesDb": "{DisputesDb.connectionString}",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "Auth__AuthService__SecretKey": "{jwt-secret.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "auth-api": {
      "type": "project.v0",
      "path": "../Services/Auth/Auth.Api/Auth.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{auth-api.bindings.http.targetPort}",
        "ConnectionStrings__IdentityDb": "{IdentityDb.connectionString}",
        "Auth__AuthService__SecretKey": "{jwt-secret.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "settlements-api": {
      "type": "project.v0",
      "path": "../Services/Settlements/Settlements.Api/Settlements.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{settlements-api.bindings.http.targetPort}",
        "Auth__AuthService__SecretKey": "{jwt-secret.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "aggregator": {
      "type": "project.v0",
      "path": "../Platform.Aggregator/Platform.Aggregator.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{aggregator.bindings.http.targetPort}",
        "services__payments-api__http__0": "{payments-api.bindings.http.url}",
        "services__payments-api__https__0": "{payments-api.bindings.https.url}",
        "services__billing-api__http__0": "{billing-api.bindings.http.url}",
        "services__billing-api__https__0": "{billing-api.bindings.https.url}",
        "services__disputes-api__http__0": "{disputes-api.bindings.http.url}",
        "services__disputes-api__https__0": "{disputes-api.bindings.https.url}",
        "Auth__AuthService__SecretKey": "{jwt-secret.value}",
        "ConnectionStrings__redis": "{redis.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "gateway": {
      "type": "project.v0",
      "path": "../Platform.ApiGateway/Platform.ApiGateway.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{gateway.bindings.public.targetPort}",
        "services__payments-api__http__0": "{payments-api.bindings.http.url}",
        "services__payments-api__https__0": "{payments-api.bindings.https.url}",
        "services__billing-api__http__0": "{billing-api.bindings.http.url}",
        "services__billing-api__https__0": "{billing-api.bindings.https.url}",
        "services__disputes-api__http__0": "{disputes-api.bindings.http.url}",
        "services__disputes-api__https__0": "{disputes-api.bindings.https.url}",
        "services__aggregator__http__0": "{aggregator.bindings.http.url}",
        "services__aggregator__https__0": "{aggregator.bindings.https.url}",
        "services__auth-api__http__0": "{auth-api.bindings.http.url}",
        "services__auth-api__https__0": "{auth-api.bindings.https.url}",
        "services__settlements-api__http__0": "{settlements-api.bindings.http.url}",
        "services__settlements-api__https__0": "{settlements-api.bindings.https.url}",
        "Auth__AuthService__SecretKey": "{jwt-secret.value}"
      },
      "bindings": {
        "public": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8080
        }
      }
    },
    "mongo-password": {
      "type": "parameter.v0",
      "value": "{mongo-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    },
    "redis-password": {
      "type": "parameter.v0",
      "value": "{redis-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    }
  }
}